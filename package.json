{
  "name": "@emulsify/cli",
  "productName": "Emulsify CLI",
  "version": "2.3.0",
  "description": "Command line interface for Emulsify",
  "repository": "git@github.com:emulsify-ds/emulsify-cli.git",
  "author": "Patrick Coffey <patrickcoffey48@gmail.com>",
  "license": "GPL-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "emulsify": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "prebuild": "npm run clean",
    "build": "npm run build-schema-types && npm run build-ts",
    "postbuild": "node --input-type=module --eval \"import { chmod } from 'node:fs/promises'; await chmod('dist/index.js', 0o755);\"",
    "build-ts": "tsc --build tsconfig.dist.json",
    "build-schema-types": "node --import ./src/register.mjs ./src/scripts/jsonSchemaToTs.ts",
    "watch": "nodemon --watch src --ext ts,json --ignore src/types --exec npm run build",
    "watch-ts": "nodemon --watch src --ext ts,json --ignore src/types --exec npm run build-ts",
    "format": "prettier --write './src/**/*.{js,ts}'",
    "husky:commit-msg": "commitlint --edit $1",
    "husky:pre-commit": "lint-staged",
    "husky:pre-push": "npm run test",
    "test": "npm run test:unit && npm run test:release",
    "test:unit": "jest --coverage --silent",
    "test:release": "node --test ./scripts/version-develop.test.mjs ./scripts/verify-release-analysis.test.mjs",
    "lint": "npm run test",
    "type": "tsc --noEmit",
    "twatch": "jest --no-coverage --watch --verbose",
    "version:develop": "node ./scripts/version-develop.mjs",
    "release:analyze": "node ./scripts/verify-release-analysis.mjs",
    "release:verify": "npm run build && npm run type && npm run test && npm run pack:dry-run && npm run smoke:pack && npm run release:analyze",
    "semantic-release": "semantic-release --config ./release.config.cjs",
    "pack:dry-run": "node ./scripts/pack-dry-run.mjs",
    "smoke:pack": "node ./scripts/smoke-pack.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/progress": "^2.0.7",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "boxen": "^8.0.1",
    "colorette": "^2.0.20",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "fs-extra": "^11.3.6",
    "progress": "^2.0.3",
    "simple-git": "^3.36.0"
  }
}
