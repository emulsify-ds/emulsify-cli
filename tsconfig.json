{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"strict": true,
		"moduleResolution": "NodeNext",
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"src/*": ["./src/*"]
		},
		"pretty": true,
		"removeComments": true,
		"resolveJsonModule": true,
		"types": ["jest", "node"],
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true
	},
	"ts-node": {
		"esm": true
	},
	"include": ["src/**/*.ts"]
}
